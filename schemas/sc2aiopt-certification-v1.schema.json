{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Valessc2/SC2AIOptimize/schemas/sc2aiopt-certification-v1.schema.json",
  "title": "SC2AIOptimize certification manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "generated_utc", "hardware", "workload", "proof", "benchmarks"],
  "properties": {
    "schema_version": {"const": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "generated_utc": {"type": "string", "minLength": 1},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cpu", "os", "compiler", "build_config"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "build_config": {"type": "string", "minLength": 1}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "version", "kind", "sc2_build", "data_version", "corpus_identity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["synthetic", "representative"]},
        "sc2_build": {"type": "string", "minLength": 1},
        "data_version": {"type": "string", "minLength": 1},
        "corpus_identity": {"type": "string", "minLength": 1}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_design", "build_tests", "representative_benchmark", "consumer_integration", "ladder_runtime"],
      "properties": {
        "source_design": {"type": "boolean"},
        "build_tests": {"type": "boolean"},
        "representative_benchmark": {"type": "boolean"},
        "consumer_integration": {"type": "boolean"},
        "ladder_runtime": {"type": "boolean"}
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "workload_size", "samples", "mean_total_cost_ns", "p50_ns", "p95_ns", "p99_ns", "correctness_passed"],
        "properties": {
          "candidate": {"type": "integer", "minimum": 0},
          "workload_size": {"type": "integer", "minimum": 0},
          "samples": {"type": "integer", "minimum": 1},
          "mean_total_cost_ns": {"type": "number", "minimum": 0},
          "p50_ns": {"type": "integer", "minimum": 0},
          "p95_ns": {"type": "integer", "minimum": 0},
          "p99_ns": {"type": "integer", "minimum": 0},
          "correctness_passed": {"type": "boolean"}
        }
      }
    }
  }
}
